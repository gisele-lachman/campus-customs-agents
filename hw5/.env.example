# Copy this file to hw5/.env and fill in your own key. Never commit .env.

# Required: your Portkey API key (used for every agent; the only model is gpt-6-luna).
PORTKEY_API_KEY=your-portkey-key-here

# Optional, for tests only. Leave these commented out for normal use.
# Point the backend at a scratch database / audit file inside data/scratch/ (anything else is refused).
# CAMPUS_CUSTOMS_DB=data/scratch/your_test.db
# CAMPUS_CUSTOMS_AUDIT=data/scratch/your_audit.json
# MCP server role: "agent" (default, read + prepare tools) or "backend" (adds the human-only approve/pay tools).
# CAMPUS_CUSTOMS_ROLE=agent

# Front end (set in frontend/.env.local, not here): backend address, default http://localhost:8000.
# VITE_API_BASE=http://localhost:8000
